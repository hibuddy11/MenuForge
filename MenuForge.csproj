<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MenuForge</RootNamespace>
    <AssemblyName>MenuForge</AssemblyName>
    <Version>1.0.0</Version>
    <Product>MenuForge</Product>
    <Description>Customize the Windows Explorer context menu: add, edit and remove entries with full command and argument configuration.</Description>
    <Authors>hibuddy11</Authors>
    <ApplicationIcon>Assets\MenuForge.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
